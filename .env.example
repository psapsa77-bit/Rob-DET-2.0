# ============================================
# Rob-DET 2.0 - Variáveis de Ambiente
# ============================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha com suas configurações reais
# 3. NUNCA commite o arquivo .env
# ============================================

# ==========================================
# CERTIFICADO DIGITAL
# ==========================================
# Caminho para o certificado .pfx (A1)
CERT_PATH=./certs/certificado.pfx

# Senha do certificado (RECOMENDADO: use keyring em vez disso)
# CERT_PASSWORD=sua_senha_aqui

# Usar keyring do sistema para senha (true/false)
USE_KEYRING=true

# Nome do serviço no keyring
KEYRING_SERVICE=det_robot

# ==========================================
# SELENIUM / NAVEGADOR
# ==========================================
# Navegador a ser utilizado (chrome/edge)
BROWSER=chrome

# Modo headless (true/false) - não exibe o navegador
HEADLESS=false

# Timeout padrão em segundos
DEFAULT_TIMEOUT=30

# Delay entre ações (em segundos) - humanizar automação
ACTION_DELAY=1.5

# ==========================================
# DET PORTAL
# ==========================================
# URL do portal DET
DET_URL=https://det.sit.trabalho.gov.br/

# Método de autenticação (certificado/govbr)
AUTH_METHOD=certificado

# ==========================================
# PROCURAÇÃO ELETRÔNICA
# ==========================================
# CNPJ do contador/escritório (responsável)
CONTADOR_CNPJ=00.000.000/0001-00

# CPF do responsável (se aplicável)
CONTADOR_CPF=000.000.000-00

# ==========================================
# LOGGING
# ==========================================
# Nível de log (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Arquivo de log
LOG_FILE=./logs/det_robot.log

# Rotação de logs (tamanho máximo em MB)
LOG_MAX_SIZE=10

# Número de arquivos de backup
LOG_BACKUP_COUNT=5

# ==========================================
# BANCO DE DADOS
# ==========================================
# SQLite (padrão)
DATABASE_URL=sqlite:///./data/det_messages.db

# PostgreSQL (produção - opcional)
# DATABASE_URL=postgresql://user:password@localhost:5432/det_robot

# ==========================================
# EXPORTAÇÃO DE DADOS
# ==========================================
# Diretório para exports
EXPORT_DIR=./data/exports

# Formato padrão de exportação (excel/csv/json)
EXPORT_FORMAT=excel

# ==========================================
# AGENDAMENTO
# ==========================================
# Ativar agendamento automático (true/false)
ENABLE_SCHEDULING=false

# Horários de execução (formato cron ou HH:MM)
SCHEDULE_TIME=09:00

# Dias da semana (0=segunda, 6=domingo) - separados por vírgula
SCHEDULE_DAYS=0,1,2,3,4

# ==========================================
# NOTIFICAÇÕES (OPCIONAL)
# ==========================================
# Ativar notificações (true/false)
ENABLE_NOTIFICATIONS=false

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
EMAIL_TO=destinatario@exemplo.com

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id

# ==========================================
# PROXY (OPCIONAL)
# ==========================================
# Usar proxy (true/false)
USE_PROXY=false

# URL do proxy
PROXY_URL=http://proxy.empresa.com:8080

# Autenticação proxy
PROXY_USER=usuario
PROXY_PASS=senha

# ==========================================
# DESENVOLVIMENTO
# ==========================================
# Modo debug (true/false)
DEBUG=false

# Salvar screenshots de erros
SAVE_ERROR_SCREENSHOTS=true

# Diretório de screenshots
SCREENSHOT_DIR=./logs/screenshots

# ==========================================
# SEGURANÇA
# ==========================================
# Tempo máximo de execução (minutos) - safety timeout
MAX_EXECUTION_TIME=60

# Tentativas de retry em caso de erro
MAX_RETRIES=3

# Delay entre retries (segundos)
RETRY_DELAY=5
